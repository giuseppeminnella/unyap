{
  "manifest_version": 3,
  "name": "Unyap",
  "version": "1.0.0",
  "description": "Skip YouTube filler: jump straight to the part that answers the title. Uses your own OpenAI API key.",
  "homepage_url": "https://giuseppe.dev/unyap/",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Unyap",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": ["https://api.openai.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "page.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
