{
  "name": "unyap",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Impatience, now a browser extension. Skip YouTube filler and jump to the answer.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "package": "node scripts/package.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test 'pipeline/*.test.ts' 'shared/**/*.test.ts' 'extension/**/*.test.ts' 'scripts/**/*.test.ts'",
    "e2e": "npm run build && playwright test",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/chrome": "0.3.6",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
